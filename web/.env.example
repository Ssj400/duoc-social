# Copiar a .env.local y pegar la clave (nunca versionar .env.local).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# true = proveedor simulado (desarrollo sin gastar cuota). Sin clave también usa mock.
LLM_MOCK=true
# LLM_TIMEOUT_MS=10000
# Respaldo: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3.5-flash-lite
